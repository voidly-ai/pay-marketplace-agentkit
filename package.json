    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@coinbase/agentkit": "0.10.4"
  },
  "devDependencies": {
    "@coinbase/agentkit": "0.10.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "voidpay",
    "marketplace",
    "coinbase-agentkit",
    "action-provider",
    "wallet-kit"
  ]
